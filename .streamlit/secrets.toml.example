# Copy this file to secrets.toml (same folder) and fill in your own
# values - secrets.toml is gitignored and Streamlit loads it automatically.
#
# Get these from a free Spotify Developer app:
#   1. Go to https://developer.spotify.com/dashboard and log in
#      (or create a free Spotify account first if you don't have one).
#   2. Click "Create app". Any name/description works.
#   3. Under Redirect URIs, add exactly: http://127.0.0.1:8501
#      Spotify's Feb 2025 security update rejects "localhost" as a
#      hostname now - it must be the literal IP 127.0.0.1, on whatever
#      port `streamlit run` is using (8501 by default). This is required
#      even if you only ever plan to use the app-only Client Credentials
#      feature below, and it's what makes the "My Spotify" login tab
#      (Connect Spotify account -> recently-played, playlists, playback
#      control, Liked Songs) work.
#   4. Open the new app's Settings and copy the Client ID and Client
#      Secret shown there.
#
# EmotiSense works completely fine without this file. With no
# secrets.toml, or with these left blank, both the plain album-art
# embed and the "My Spotify" login tab are simply hidden/disabled, and
# the app behaves exactly as it did before either feature existed.

SPOTIFY_CLIENT_ID = "your-client-id-here"
SPOTIFY_CLIENT_SECRET = "your-client-secret-here"

# Only needed if you run Streamlit on a port other than the default 8501
# (e.g. `streamlit run app/app.py --server.port 8502`) - must exactly
# match one of the Redirect URIs registered on the app above, including
# the http:// and port number.
# SPOTIFY_REDIRECT_URI = "http://127.0.0.1:8501"
